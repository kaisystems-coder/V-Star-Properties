# Canonical site origin. Must be set before any public deploy, or canonical
# links and share cards point at localhost.
NEXT_PUBLIC_SITE_URL=https://www.vstarproperties.tt

# OPTIONAL overrides. The Supabase URL, publishable key and tenant default to
# V-Star on the shared project (lib/supabase/config.ts and tenant.ts), so a
# deploy needs none of these. Set them only to point the code elsewhere.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# TENANT_ID=

# No service-role key is needed by this app. Never add one with a NEXT_PUBLIC_ prefix.
