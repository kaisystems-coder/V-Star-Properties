# Canonical site origin. Must be set before any public deploy, or canonical
# links and share cards point at localhost.
NEXT_PUBLIC_SITE_URL=https://www.vstarproperties.tt

# Supabase (when the backend goes in). See README section 2 and supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only, for supabase/seed.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
