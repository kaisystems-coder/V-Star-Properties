# Canonical site origin. Must be set before any public deploy, or canonical
# links and share cards point at localhost.
NEXT_PUBLIC_SITE_URL=https://www.vstarproperties.tt

# Shared multi-tenant Supabase project (see supabase/README.md). Both values are
# public by design: RLS does the enforcing.
NEXT_PUBLIC_SUPABASE_URL=https://ezotkeijhffwylgsjkhq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# This site's tenant (public.tenants.id, slug v-star-properties). Server-side
# only: it scopes every read and the admin. Never take it from the browser.
TENANT_ID=949f81ee-ba83-4f50-ab7c-1c6545759543

# No service-role key is needed by this app. Never add one with a NEXT_PUBLIC_ prefix.
